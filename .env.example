SKANEVUX_MCP_API_TIMEOUT_SECONDS=30
SKANEVUX_MCP_HOST=0.0.0.0
SKANEVUX_MCP_PORT=8000
SKANEVUX_MCP_MCP_PATH=/mcp
# Required. The MCP path enforces `Authorization: Bearer <key>`; the server refuses to start if unset.
# This is a throwaway local value — set a strong, unique key in any real deployment.
SKANEVUX_MCP_API_KEY=dev-local-key

# Used only by docker-compose.yml (Traefik TLS). Subdomain must resolve to this VM's IP.
DOMAIN=skanevux-mcp.example.com
ACME_EMAIL=admin@example.com
